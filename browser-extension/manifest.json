{
  "manifest_version": 3,
  "name": "Scarn's Name Sniffer Autofill",
  "version": "2.6.0",
  "description": "Autofills Roblox signup for Name Sniffer v2.6 and lets Enter activate Roblox's normal Create Account button.",
  "permissions": ["clipboardRead", "clipboardWrite", "storage"],
  "action": {
    "default_title": "Scarn's Name Sniffer Autofill",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.roblox.com/CreateAccount*"],
      "js": ["content.js", "enter-submit.js"],
      "run_at": "document_idle"
    }
  ]
}
